  <script>
    (function () {
      var btn = document.getElementById('mobile-menu-toggle');
      var panel = document.getElementById('mobile-menu-panel');
      if (!btn || !panel) return;
      var bars = btn.querySelector('[data-icon-bars]');
      var x = btn.querySelector('[data-icon-x]');
      btn.addEventListener('click', function () {
        var open = panel.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (bars && x) {
          bars.classList.toggle('opacity-0', open);
          bars.classList.toggle('scale-90', open);
          x.classList.toggle('opacity-0', !open);
          x.classList.toggle('scale-90', !open);
        }
      });
    })();
